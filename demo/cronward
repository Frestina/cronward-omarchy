#!/usr/bin/env bash
# A fake cronward for screenshots and trying the widget's states: prints
# demo/fixtures/<state>.json for `status --json`, with its times moved to
# now, and does nothing for the rest. The state is the first line of
# $XDG_RUNTIME_DIR/cronward-demo, else "mixed". Two more states have no
# fixture: "not-set-up" and "error". A state "workflows-NAME" shows the
# mixed status, and prints demo/fixtures/workflows/NAME.json for `workflows
# --json` (else list.json); "workflows-unreachable" and "workflows-readonly"
# fail as ssh and a key that only reads the status would. `add` prints
# demo/fixtures/add/added.txt, whatever job it is given; the states
# "add-refused" and "add-unreachable" show the mixed status, and make `add`
# refuse as GitHub's check would, or fail as ssh would. `run` and `remove`
# print demo/fixtures/action/run-started.txt and removed.txt; in the state
# "run-refused" the start does not go through, and in "action-unreachable"
# both fail as ssh would. `token remove` prints action/account-removed.txt,
# or in the state "account-old" account-old.txt, as a cronward from before
# it took the account out of the config. Fictional names only.
set -euo pipefail
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
state=$(head -n1 "${XDG_RUNTIME_DIR:-/tmp}/cronward-demo" 2>/dev/null || true)
state=${state:-mixed}
# On a viewer the widget runs `cronward --on HOST ...`: the same here.
if [[ ${1:-} == --on ]]; then shift 2; fi
case ${1:-} in
  status) ;;
  workflows)
    case $state in
      workflows-unreachable) printf '%s\n' "ssh: connect to host homeserver port 22: Connection refused" \
        "cronward: cannot run cronward on homeserver: ssh failed (above)" >&2; exit 2 ;;
      workflows-readonly) echo "cronward: this key only reads the status" >&2; exit 1 ;;
    esac
    name=list; [[ $state == workflows-* ]] && name=${state#workflows-}
    sleep 1; cat "$here/fixtures/workflows/$name.json"
    # cronward exits 2 when an account's repos could not be listed.
    [[ $name == account-error ]] && exit 2; exit 0 ;;
  add)
    sleep 1
    case $state in
      add-refused) cat "$here/fixtures/add/refused.txt" >&2; exit 1 ;;
      add-unreachable) printf '%s\n' "ssh: connect to host homeserver port 22: Connection refused" \
        "cronward: cannot run cronward on homeserver: ssh failed (above)" >&2; exit 2 ;;
    esac
    cat "$here/fixtures/add/added.txt"; exit 0 ;;
  run|remove)
    sleep 1
    if [[ $state == action-unreachable ]]; then
      printf '%s\n' "ssh: connect to host homeserver port 22: Connection refused" \
        "cronward: cannot run cronward on homeserver: ssh failed (above)" >&2; exit 2
    fi
    if [[ $1 == remove ]]; then cat "$here/fixtures/action/removed.txt"; exit 0; fi
    if [[ $state == run-refused ]]; then cat "$here/fixtures/action/run-refused.txt"; exit 1; fi
    cat "$here/fixtures/action/run-started.txt"; exit 0 ;;
  token)
    if [[ ${2:-} == remove ]]; then
      sleep 1
      if [[ $state == account-old ]]; then cat "$here/fixtures/action/account-old.txt"
      else cat "$here/fixtures/action/account-removed.txt"; fi
      exit 0
    fi
    echo "demo: cronward $*: nothing done, this is the demo"; exit 0 ;;
  watch) sleep 1; exit 0 ;;
  *) echo "demo: cronward $*: nothing done, this is the demo" ; exit 0 ;;
esac
case $state in
  not-set-up) echo "cronward: no config at $HOME/.config/cronward/config.toml; write one with: cronward init" >&2; exit 2 ;;
  error) echo "cronward: state.json does not read: Expecting value: line 1 column 1 (char 0)" >&2; exit 2 ;;
esac
case $state in workflows-*|add-*|run-*|remove-*|action-*|account-*) state=mixed ;; esac
fixture=$here/fixtures/$state.json
[[ -f $fixture ]] || { echo "demo: no fixture $state" >&2; exit 2; }
python3 -I - "$fixture" <<'PY'
import json, sys, time
st = json.load(open(sys.argv[1]))
shift = time.time() - 1793711280  # the fixtures' now, 2026-11-03 13:08 UTC
def move(o):
    if isinstance(o, dict):
        return {k: (v + shift if k in ("now", "last_tick", "next", "slot", "finished", "fetched",
                                       "unreachable_since") and isinstance(v, (int, float))
                    else move(v)) for k, v in o.items()}
    return [move(v) for v in o] if isinstance(o, list) else o
json.dump(move(st), sys.stdout, indent=1)
PY
